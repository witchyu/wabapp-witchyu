# ---- ฐานข้อมูล: Neon (Postgres ฟรี ไม่หมดอายุ ไม่ต้องใช้บัตร) ----
# 1) สมัคร neon.com → New Project (เลือก Region: Singapore ใกล้ไทยที่สุด)
# 2) หน้า Dashboard กด Connect → ปิดสวิตช์ "Connection pooling" → คัดลอก connection string มาวางแทนบรรทัดล่าง
# 3) ต่อท้ายด้วย &connect_timeout=15 (กันกรณีเครื่องกำลังตื่นจากการพัก)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

PORT=4000

# เว็บที่อนุญาตให้เรียก API ตรง ๆ (คั่นด้วยเครื่องหมายจุลภาค) — ถ้าเปิดผ่าน Vite proxy ไม่ต้องใช้
FRONTEND_ORIGIN="http://localhost:5173"

# การชำระเงินจำลอง (Phase 7 จะใช้ของจริง) ห้ามเปิดใน Production
ALLOW_MOCK_PAYMENT=true

# ---- แอดมิน (Phase 4) ----
# คีย์ลับสำหรับเซ็นโทเคนล็อกอินแอดมิน (ห้ามเปิดเผย / ห้ามขึ้น GitHub) สร้างค่าด้วยคำสั่ง:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=

# ใช้กับ `npm run admin:create` ครั้งเดียว — รันเสร็จแล้ว "ลบบรรทัด ADMIN_PASSWORD ทิ้ง"
# username: a-z 0-9 _ . - (3-32 ตัว) / password: อย่างน้อย 10 ตัวอักษร และไม่มีชื่อผู้ใช้อยู่ในนั้น
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=
